APP_NAME=Petmin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_TW

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 正式機 PostgreSQL（與 gotcha / hazdar 共用同一台，DB 名稱 petmin）
# 本機快速開發可改 DB_CONNECTION=sqlite 並刪掉 DB_HOST/PORT/USERNAME/PASSWORD
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=petmin
DB_USERNAME=petmin
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# hackathon 期間不依賴 Redis / Horizon；正式機要用 Horizon 再改回 redis
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=petmin

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# 正式機與其他站共用 Redis：petmin 用獨立 DB（其他站用預設 0／1），避免互相清快取、鍵名衝突
REDIS_DB=10
REDIS_CACHE_DB=11
REDIS_PREFIX=petmin_

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@petmin.local"
MAIL_FROM_NAME="${APP_NAME}"

# ===== Socialite =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI="${APP_URL}/auth/line/callback"
LIFF_ID=

# ===== Claude Vision 照片審核（未填則 fail-open，留人工審） =====
CLAUDE_API_KEY=

# ===== 地圖 =====
RADAR_DEFAULT_LAT=25.0330
RADAR_DEFAULT_LNG=121.5654
RADAR_DEFAULT_ZOOM=13
PETMIN_BASEMAP_LIGHT_STYLE_URL=https://tiles.puma.taipei/styles/light.json
PETMIN_BASEMAP_DARK_STYLE_URL=https://tiles.puma.taipei/styles/dark.json

# ===== 管理員保護 =====
# Comma-separated emails whose admin rights cannot be revoked via the panel
PROTECTED_ADMIN_EMAILS=

VITE_APP_NAME="${APP_NAME}"
